---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map((story) => ({ params: { id: story.id }, props: { story } }));
}
interface Props { story: CollectionEntry<'stories'> }
const { story } = Astro.props;
const { Content } = await render(story);
---
<BaseLayout title={`${story.data.title} — Padmaja Mazumder`} description={story.data.description} article>
  <article class="story-article container"><a class="back-link" href="/off-the-clock/"><Icon name="arrow-right" size={16} /> Back to the notebook</a><header><p class="section-label">{story.data.genre}</p><h1>{story.data.title}</h1><p>{story.data.description}</p><time datetime={story.data.date.toISOString()}>{story.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></header><div class="prose"><Content /></div><footer><span>Written by Padmaja Mazumder</span><a class="text-link" href="/off-the-clock/">More from the notebook <Icon name="arrow-up-right" size={16} /></a></footer></article>
</BaseLayout>
