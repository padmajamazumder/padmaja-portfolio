---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedStories, readingMinutes, formatStoryDate } from '../../lib/stories';
import '../../styles/diary.css';

export async function getStaticPaths() {
  const stories = await getPublishedStories();
  return stories.map((story, index) => ({ params: { id: story.id }, props: {
    story, index, total: stories.length,
    previous: stories[index - 1] ? { id: stories[index - 1].id, title: stories[index - 1].data.title } : undefined,
    next: stories[index + 1] ? { id: stories[index + 1].id, title: stories[index + 1].data.title } : undefined,
  } }));
}
interface Neighbor { id: string; title: string }
interface Props { story: CollectionEntry<'stories'>; index: number; total: number; previous?: Neighbor; next?: Neighbor }
const { story, index, total, previous, next } = Astro.props;
const { Content } = await render(story);
const poetry = story.data.genre.toLowerCase() === 'poetry';
---
<BaseLayout title={`${story.data.title} — Padmaja Mazumder`} description={story.data.description} article>
  <article class="diary-article container">
    <div class="reader-topline"><a class="back-link" href="/off-the-clock/#notebook"><Icon name="arrow-right" size={16} /> Back to the notebook</a><span>PAGE {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}</span></div>
    <header class="diary-article-heading">
      <p class="section-label">{story.data.genre} / FROM THE NOTEBOOK</p>
      <h1>{story.data.title}</h1>
      <div class="reader-meta"><span>By Padmaja Mazumder</span><span aria-hidden="true">·</span><span>{readingMinutes(story)} min read</span>{story.data.date && <><span aria-hidden="true">·</span><time datetime={story.data.date.toISOString()}>{formatStoryDate(story.data.date)}</time></>}</div>
      {story.data.tags.length > 0 && <div class="reader-tags">{story.data.tags.filter((tag) => tag !== story.data.genre).map((tag) => <span>{tag}</span>)}</div>}
    </header>

    <div class:list={['diary-reading-layout', { 'without-cover': !story.data.cover }]}>
      {story.data.cover && <aside class="reader-artwork" aria-label="Artwork accompanying the poem"><figure><Image src={story.data.cover} alt={story.data.coverAlt ?? `Artwork accompanying ${story.data.title}`} widths={Array.from(new Set([240, 400, story.data.cover.width].filter((width) => width <= story.data.cover!.width)))} sizes="(max-width: 600px) 80vw, (max-width: 900px) 30vw, 350px" format="webp" quality={85} loading="eager" /><figcaption>The image that shared this page.</figcaption></figure><span class="reader-art-note" aria-hidden="true">a moment, held still.</span></aside>}
      <div class:list={['prose', 'diary-prose', { poetry }]}><Content /><div class="poem-end" aria-hidden="true"><span></span>✧<span></span></div><p class="reader-signature">Padmaja Mazumder</p></div>
    </div>

    <nav class="reader-pagination" aria-label="Continue reading">
      {previous ? <a href={`/off-the-clock/${previous.id}/`} class="reader-previous"><span><Icon name="arrow-right" class="previous-arrow" size={15} /> THE PREVIOUS PAGE</span><strong>{previous.title}</strong></a> : <a href="/off-the-clock/#notebook" class="reader-previous"><span><Icon name="book" size={15} /> THE WHOLE NOTEBOOK</span><strong>Find another page to stay with.</strong></a>}
      {next ? <a href={`/off-the-clock/${next.id}/`} class="reader-next"><span>TURN THE PAGE <Icon name="arrow-right" size={15} /></span><strong>{next.title}</strong></a> : <a href="/off-the-clock/#notebook" class="reader-next"><span>BACK TO THE NOTEBOOK <Icon name="arrow-up-right" size={15} /></span><strong>Every ending leaves a little room.</strong></a>}
    </nav>
  </article>
</BaseLayout>
