  'globe': ['M2 12h20M12 2a16 16 0 0 1 0 20 16 16 0 0 1 0-20'],
  'book': ['M12 5v16M12 5C8 2 4 3 2 4v15c3-1 6-1 10 2 4-3 7-3 10-2V4c-2-1-6-2-10 1'],
  'menu': ['M4 7h16M4 12h16M4 17h16'],
